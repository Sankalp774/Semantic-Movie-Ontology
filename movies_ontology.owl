<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/movies_ontology.owl"
         xmlns="http://example.org/movies_ontology.owl#">

<owl:Ontology rdf:about="http://example.org/movies_ontology.owl"/>

<owl:ObjectProperty rdf:about="#hasGenre">
  <rdfs:domain rdf:resource="#Movie"/>
  <rdfs:range rdf:resource="#Genre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDirector">
  <rdfs:domain rdf:resource="#Movie"/>
  <rdfs:range rdf:resource="#Director"/>
  <owl:inverseOf rdf:resource="#directed"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasActor">
  <rdfs:domain rdf:resource="#Movie"/>
  <rdfs:range rdf:resource="#Actor"/>
  <owl:inverseOf rdf:resource="#actedIn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#actedIn">
  <rdfs:domain rdf:resource="#Actor"/>
  <rdfs:range rdf:resource="#Movie"/>
  <owl:inverseOf rdf:resource="#hasActor"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#directed">
  <rdfs:domain rdf:resource="#Director"/>
  <rdfs:range rdf:resource="#Movie"/>
  <owl:inverseOf rdf:resource="#hasDirector"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasTitle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Movie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#hasReleaseYear">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Movie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Movie">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Actor">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Director">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Genre">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Action">
  <rdf:type rdf:resource="#Genre"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SciFi">
  <rdf:type rdf:resource="#Genre"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ChristopherNolan">
  <rdf:type rdf:resource="#Director"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LeonardoDiCaprio">
  <rdf:type rdf:resource="#Actor"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Inception">
  <rdf:type rdf:resource="#Movie"/>
  <hasGenre rdf:resource="#Action"/>
  <hasGenre rdf:resource="#SciFi"/>
  <hasDirector rdf:resource="#ChristopherNolan"/>
  <hasActor rdf:resource="#LeonardoDiCaprio"/>
  <hasTitle rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inception</hasTitle>
  <hasReleaseYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2010</hasReleaseYear>
</owl:NamedIndividual>


</rdf:RDF>
